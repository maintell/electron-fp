   // The user agent string.
@@ -677,6 +712,24 @@ struct NetworkContextParams {
   // do not have an associated `URLLoaderFactory`.
   pending_remote<URLLoaderNetworkServiceObserver>?
       device_bound_sessions_network_observer;
+
+  // ------------------------------------------------------------------------
+  // Fingerprint profile: HTTP/2 behavior.
+  //
+  // Every field is optional so that "unset" means "keep whatever
+  // ParseCommandLineAndFieldTrials decided", which keeps an unprofiled context
+  // byte-identical to stock Chromium. See net/http/http_network_session.h.
+  //
+  // WHY THIS EXISTS WHEN --http2-grease-settings ALREADY WORKS: that switch is
+  // process-wide, read once at NetworkContext construction. These fields are
+  // per-NetworkContext, so a profile can differ per session. Verified: the
+  // switch does take effect in Electron, so a Chrome-matching build needs
+  // either the switch or fp_http2_settings_grease=true, not both.
+  // ------------------------------------------------------------------------
+
+  // Per-profile HTTP/2 shaping. Unset (null) keeps whatever
+  // ParseCommandLineAndFieldTrials decided, preserving stock behavior.
+  Http2Profile? fp_http2_profile;
 };
 
 struct NetworkConditions {
# --- services/network/public/mojom/ssl_config.mojom ---
# RANGE: SSLConfig struct, fp_* fields appended.
# PURPOSE: cross-process transport for the profile. Bindings regenerate
# at build time; no manual steps on upgrade.
diff --git a/services/network/public/mojom/ssl_config.mojom b/services/network/public/mojom/ssl_config.mojom
index 8c748ceed155c..4f1dd2c944a08 100644
--- a/services/network/public/mojom/ssl_config.mojom
+++ b/services/network/public/mojom/ssl_config.mojom
@@ -91,6 +91,49 @@ struct SSLConfig {
   // MtcMetadata was generated. See also MtcMetadata.update_time_seconds in
   // net/cert/root_store.proto.
   int64 mtc_update_time_seconds;
+
+  // -------------------------------------------------------------------------
+  // Fingerprint profile: browser-profile-driven TLS ClientHello shaping.
+  //
+  // Every field here describes TLS *behavior*. None of them stores a target
+  // JA3/JA4 - those are derived on the wire from what these produce, and
+  // storing them would invert the dependency and make the profile
+  // unverifiable. Empty/unset means "use stock Chromium behavior".
+  // -------------------------------------------------------------------------
+
+  // Replaces Chromium's built-in cipher list command
+  // ("ALL:!aPSK:!ECDSA+SHA1:!3DES"). Passed to SSL_set_strict_cipher_list().
+  // Empty = keep the built-in list.
+  string fp_cipher_list;
+
+  // Replaces Chromium's built-in signature-algorithm preference list.
+  // Empty = keep the built-in kVerifyPrefs order.
+  array<uint16> fp_signature_algorithms;
+
+  // GREASE (RFC 8701), normally hardcoded on in Chromium. Because BoringSSL
+  // only offers SSL_CTX-level GREASE setters, setting these selects a
+  // pre-built per-profile SSL_CTX rather than mutating a shared one.
+  bool? fp_grease_enabled;
+  bool? fp_grease_sigalgs_enabled;
+
+  // ClientHello extension-order permutation, normally hardcoded on.
+  // Turning it off makes the order FIXED (more fingerprintable, not less);
+  // pair with fp_extension_order for a deliberate order.
+  bool? fp_permute_extensions;
+
+  // Explicit extension order. Empty = BoringSSL's own ordering.
+  array<uint16> fp_extension_order;
+
+  // Omit the ALPN extension. Contradicts HTTP/2 use; the consistency engine
+  // is responsible for rejecting that combination.
+  bool fp_omit_alpn = false;
+
+  // Omit the session_ticket extension (sets SSL_OP_NO_TICKET).
+  bool fp_omit_session_ticket = false;
+
+  // Cap the TLS version advertised in supported_versions. Distinct from
+  // version_max, which gates what the client will accept. 0 = no override.
+  uint16 fp_advertised_version_max;
 };
 
