-                         params.enable_http2_settings_grease,
-                         params.greased_http2_frame,
-                         params.http2_end_stream_with_data_frame,
+                         // Fingerprint profile: each of these falls back to the
+                         // stock value when the profile does not set it, so an
+                         // unprofiled context behaves exactly like upstream.
+                         params.fp_http2_settings_grease.value_or(
+                             params.enable_http2_settings_grease),
+                         params.fp_greased_http2_frame.value_or(
+                             params.greased_http2_frame),
+                         params.fp_http2_end_stream_with_data_frame.value_or(
+                             params.http2_end_stream_with_data_frame),
                          params.enable_priority_update,
                          params.spdy_go_away_on_ip_change,
                          params.time_func,
