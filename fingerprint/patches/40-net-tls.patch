+    if (p->settings_grease.has_value()) {
+      session_params.fp_http2_settings_grease = p->settings_grease.value();
+    }
+    if (p->end_stream_with_data_frame.has_value()) {
+      session_params.fp_http2_end_stream_with_data_frame =
+          p->end_stream_with_data_frame.value();
+    }
+    if (p->grease_frame) {
+      net::SpdySessionPool::GreasedHttp2Frame frame;
+      frame.type = p->grease_frame->type;
+      frame.flags = p->grease_frame->flags;
+      frame.payload.assign(p->grease_frame->payload.begin(),
+                           p->grease_frame->payload.end());
+      session_params.fp_greased_http2_frame = std::move(frame);
+    }
+  }
