+  // cannot be applied per-SSL like permute_extensions. It therefore requires a
+  // per-profile SSL_CTX; see SSLClientContext::GetSSLContextForProfile().
+  std::optional<bool> fp_grease_enabled;
+  std::optional<bool> fp_grease_sigalgs_enabled;
+
+  // Extension-order permutation. When unset, Chromium's default applies
+  // (SSL_set_permute_extensions(ssl, 1)).
