+  // ParseCommandLineAndFieldTrials so a profile wins over process-wide
+  // switches, and so unset fields leave the switch/default value untouched.
+  //
+  // These are per-NetworkContext, unlike --http2-grease-settings which is
+  // process-wide; that is the only reason to prefer them over the switch.
+  if (params_->fp_http2_profile) {
+    const auto& p = params_->fp_http2_profile;
