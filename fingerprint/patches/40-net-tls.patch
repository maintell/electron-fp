# RANGE: new GreasedHttp2Frame + Http2Profile structs; one fp_http2_profile
# field appended to NetworkContextParams.
# PURPOSE: transport for the HTTP/2 profile. Grouped in a struct (rather
# than three loose optional fields) so an omitted key is unambiguous at the
# gin boundary: a bare optional<bool> cannot distinguish JS `false` from
# "key absent", which would silently misread a profile.
diff --git a/services/network/public/mojom/network_context.mojom b/services/network/public/mojom/network_context.mojom
index e266c2974e658..80b2d2ff3323a 100644
--- a/services/network/public/mojom/network_context.mojom
+++ b/services/network/public/mojom/network_context.mojom
@@ -358,6 +358,41 @@ interface CertVerifierClient {
   ) => (int32 error_code, CertVerifyResult result);
 };
 
+// A frame of a reserved (GREASE) type, emitted after each HTTP/2 SETTINGS
+// frame so that servers handle unknown frame types, per
+// draft-bishop-httpbis-grease-00.
+//
+// Mirrors net::SpdySessionPool::GreasedHttp2Frame (net/spdy/spdy_session_pool.h).
+// Separate `type`/`flags`/`payload` fields rather than a raw blob so the mojom
+// validator checks the shapes; payload is bytes because it is arbitrary-length
+// opaque data drawn from a CSPRNG.
+struct GreasedHttp2Frame {
+  // Reserved frame type: 0x0b + 0x1f * rand(8), per the GREASE draft.
+  uint8 type;
+  uint8 flags;
+  array<uint8> payload;
+};
+
+// Per-NetworkContext HTTP/2 fingerprint profile.
+//
+// Grouping these in one struct (rather than three loose optional fields on
+// NetworkContextParams) makes "unset" unambiguous at the JS boundary: a
+// hand-written gin converter cannot distinguish JS `false` from an omitted
+// key when the parameter is a bare optional<bool>, which is exactly the kind of
+// silent misinterpretation this subsystem must avoid.
+struct Http2Profile {
+  // Overrides enable_http2_settings_grease. Real Chrome greases SETTINGS;
+  // the net/ default is false, so a Chrome-matching profile sets true.
+  bool? settings_grease;
+
+  // Overrides http2_end_stream_with_data_frame: END_STREAM on an empty DATA
+  // frame instead of on HEADERS.
+  bool? end_stream_with_data_frame;
+
+  // Overrides greased_http2_frame. Real Chrome leaves this unset by default.
+  GreasedHttp2Frame? grease_frame;
+};
