# --- services/network/network_context.cc ---
# RANGE: NetworkContext constructor, after ParseCommandLineAndFieldTrials.
# PURPOSE: apply the HTTP/2 profile onto HttpNetworkSessionParams. Applied
# AFTER the command-line parse so a profile overrides a process-wide switch,
# and only when set, so an unprofiled context keeps stock behavior.
diff --git a/services/network/network_context.cc b/services/network/network_context.cc
index 2065c41667a2f..5065063b547b2 100644
--- a/services/network/network_context.cc
