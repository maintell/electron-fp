+  // Explicit ClientHello extension order, e.g. {0x000a, 0x000d, ...}.
+  //
+  // HONEST LIMITATION - NOT IMPLEMENTED: BoringSSL exposes only
+  // SSL_[CTX_]set_permute_extensions(on/off); there is no API to pin a specific
+  // ClientHello extension order. Implementing this would require patching
+  // BoringSSL's ClientHello assembly (ssl/extensions.cc), which changes a
+  // security-critical handshake path and is out of scope for this phase.
+  //
+  // The field exists so the config surface is stable and so a profile that
+  // requests it is REJECTED loudly instead of being silently ignored - a
+  // silently-ignored fingerprint setting is worse than a missing one, because
+  // the profile then claims a fingerprint it does not produce.
+  std::vector<uint16_t> fp_extension_order;
+
+  // If true, drop the ALPN extension entirely from the ClientHello. Some
+  // non-browser TLS clients do not send ALPN; Chromium always does.
+  bool fp_omit_alpn = false;
+
+  // If true, omit the session_ticket extension. Affects resumption behavior
+  // and therefore whether the ClientHello carries a PSK binder on resume.
+  bool fp_omit_session_ticket = false;
+
+  // Override the maximum TLS version advertised in supported_versions.
+  // Distinct from `version_max`, which gates what the client will ACCEPT.
+  std::optional<uint16_t> fp_advertised_version_max;
 };
 
