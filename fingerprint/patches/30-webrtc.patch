+// ---- fp: custom WebRTC IP ----
+std::string FpTrimWs(const std::string& s) {
+  std::string r = s;
+  while (!r.empty() && (r.back() == ' ' || r.back() == '\t' ||
+                        r.back() == '\r' || r.back() == '\n')) {
+    r.pop_back();
+  }
+  return r;
+}
+
+// Read a string value for |key| from JSON content.
+std::string ReadConfigValue(const std::string& content, const char* key) {
+  std::string needle = "\"";
+  needle += key;
+  needle += "\"";
+  size_t pos = content.find(needle);
+  if (pos == std::string::npos) {
+    return "";
+  }
+  size_t colon = content.find(':', pos);
+  if (colon == std::string::npos) {
+    return "";
+  }
+  size_t q1 = content.find('"', colon);
+  if (q1 == std::string::npos) {
+    return "";
+  }
+  size_t q2 = content.find('"', q1 + 1);
+  if (q2 == std::string::npos) {
+    return "";
+  }
+  return content.substr(q1 + 1, q2 - q1 - 1);
+}
+
+// fp: embedder-supplied override, set via SetCustomWebRtcIpOverride().
+// Deliberately stored outside the resolved/cached pair below: an embedder may
+// inject the value AFTER the first candidate has already been generated (Blink
+// reads it when the network list is built), so the override must always be
+// consultable and must invalidate any previously cached env-derived result.
+namespace {
+IPAddress& CustomWebRtcIpOverrideSlot() {
+  static IPAddress* slot = new IPAddress();
+  return *slot;
+}
+}  // namespace
+
+void SetCustomWebRtcIpOverride(const IPAddress& ip) {
+  IPAddress& slot = CustomWebRtcIpOverrideSlot();
+  if (slot == ip) {
+    return;
+  }
+  slot = ip;
+  // A new override supersedes anything resolved from the environment.
+  RTC_LOG(LS_INFO) << "custom WebRTC IP override "
+                   << (ip.IsNil() ? "cleared" : ("set to " + ip.ToString()));
+}
+
+IPAddress GetCustomWebRtcIp() {
+  // 0) Embedder override (e.g. --fingerprint-config via Blink) — highest
+  //    priority, checked before the one-shot env cache.
+  const IPAddress& override_ip = CustomWebRtcIpOverrideSlot();
+  if (!override_ip.IsNil()) {
+    return override_ip;
+  }
+
+  static IPAddress cached;
+  static bool resolved = false;
+  if (resolved) {
+    return cached;
+  }
+  const char* data = getenv("FP_CONFIG_DATA");
+  if (data && *data) {
+    std::string ip = ReadConfigValue(std::string(data), "webrtc_ip");
+    IPAddress addr;
+    if (!ip.empty() && IPFromString(ip, &addr)) {
+      resolved = true;
+      cached = addr;
+      return cached;
+    }
+  }
+  const char* config = getenv("FP_CONFIG");
+  if (config) {
+    std::string path = FpTrimWs(config);
+    FILE* f = fopen(path.c_str(), "rb");
+    if (f) {
+      std::string content;
+      char buf[4096];
+      size_t n;
+      while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+        content.append(buf, n);
+      }
+      fclose(f);
+      std::string ip = ReadConfigValue(content, "webrtc_ip");
+      IPAddress addr;
+      if (!ip.empty() && IPFromString(ip, &addr)) {
+        resolved = true;
+        cached = addr;
+        return cached;
+      }
+    }
+  }
+  const char* ip = getenv("FP_WEBRTC_IP");
+  if (ip) {
+    std::string ipstr = FpTrimWs(ip);
+    in_addr a4;
+    if (inet_pton(AF_INET, ipstr, &a4) == 1) {
+      resolved = true;
+      cached = IPAddress(a4);
+      return cached;
+    }
+    in6_addr a6;
+    if (inet_pton(AF_INET6, ipstr, &a6) == 1) {
+      resolved = true;
+      cached = IPAddress(a6);
+      return cached;
+    }
+    RTC_LOG(LS_ERROR) << "custom webrtc ip parse failed: " << ipstr;
+  }
+  resolved = true;
+  cached = IPAddress();
+  return cached;
+}
+
+void ApplyCustomWebRtcIp(std::vector<std::unique_ptr<Network>>& list) {
+  IPAddress custom = GetCustomWebRtcIp();
+  if (custom.IsNil()) {
+    return;
+  }
+  RTC_LOG(LS_INFO) << "Applying custom WebRTC IP: " << custom.ToString();
+  for (auto& network : list) {
+    network->ClearIPs();
+    network->AddIP(custom);
+    network->set_mdns_responder_provider(nullptr);
+  }
+}
